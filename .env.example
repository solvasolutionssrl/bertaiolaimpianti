# =====================================================================
# Kommessa — variabili d'ambiente (copia in apps/web/.env.local per lo sviluppo)
# Solo segnaposto: i valori veri stanno su Vercel e in .env.local (mai nel repo).
# =====================================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# --- variabili usate dalle Edge Functions (Deno) ---
# Su Supabase Cloud sono iniettate; con `supabase functions serve` vanno passate via --env-file.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key

# ---- Segreti condivisi ----
# Cron (pg_cron → /api/cron/*, sync R2 → Nextcloud, backfill miniature)
CRON_SECRET=replace-with-random-32-bytes
# Webhook DB → notify-event e /api/push/send-internal
NOTIFY_WEBHOOK_SECRET=replace-with-random-32-bytes
# Edge Function onboard-tenant (header `x-admin-secret`)
ONBOARDING_ADMIN_SECRET=replace-with-random-32-bytes

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
RESEND_FROM=Kommessa <notify@example.com>
RESEND_INBOUND_SECRET=replace-with-webhook-secret
# Destinatario degli avvisi di piattaforma (AI giù, integrazioni ferme)
PLATFORM_ALERT_EMAIL=ops@example.com

# ---- AI ----
# Se assente o = "placeholder" /api/voice/extract gira in anteprima (niente chiamate).
OPENAI_API_KEY=placeholder
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
OPENAI_MODEL_EXTRACT=gpt-4o-mini
OPENAI_MODEL_CHAT=gpt-5-mini
OPENAI_MODEL_VISION=gpt-5.4-mini
# Co-pilot ed Edge Functions
ANTHROPIC_API_KEY=sk-ant-...

# ---- Stima viaggi e indirizzi ----
# Chiave unica di piattaforma, usata solo per i tenant con provider "google"
GOOGLE_MAPS_API_KEY=
# Facoltativa: OpenRouteService per il provider "free" (senza, OSRM demo)
ORS_API_KEY=

# ---- Storage ----
# Lo storage di ogni tenant si configura dall'app; queste servono alle Edge Functions
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_USER=service-kommessa
NEXTCLOUD_APP_PASSWORD=replace-with-app-password
# Cloudflare R2 (upload media, spese, cestino)
R2_ACCOUNT_ID=replace-with-account-id
R2_BUCKET=replace-with-bucket
R2_ACCESS_KEY_ID=replace-with-access-key
R2_SECRET_ACCESS_KEY=replace-with-secret-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com

# ---- Web Push (VAPID) ----
VAPID_PUBLIC_KEY=replace-with-vapid-public
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public
VAPID_PRIVATE_KEY=replace-with-vapid-private
VAPID_SUBJECT=mailto:ops@example.com

# ---- Sentry ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Solo in build, per caricare le source map
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

