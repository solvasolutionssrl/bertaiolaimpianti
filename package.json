{
  "name": "impiantixplus",
  "version": "0.1.0",
  "private": true,
  "description": "impiantiXplus — SOLVA SaaS multitenant per gestione commesse impiantistiche (pilot tenant: Bertaiola Impianti)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/api/src/types/database.generated.ts"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "postcss@>=8.0.0 <8.5.18": "^8.5.18",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6"
    }
  }
}
